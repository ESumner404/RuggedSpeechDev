{
  "name": "rugged-speech-test",
  "productName": "Rugged Speech Test",
  "version": "0.0.1",
  "private": true,
  "description": "A communication companion for when speaking is difficult.",
  "author": "Ethan Sumner",
  "license": "MIT",
  "homepage": "https://github.com/ESumner404/RuggedSpeechDev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ESumner404/RuggedSpeechDev.git"
  },
  "bugs": {
    "url": "https://github.com/ESumner404/RuggedSpeechDev/issues"
  },
  "keywords": [
    "aac",
    "augmentative-communication",
    "accessibility",
    "speech",
    "autism",
    "electron",
    "preact",
    "offline"
  ],
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@preact/signals": "^1.3.0",
    "idb": "^8.0.0",
    "preact": "^10.24.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.9.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "jsqr": "^1.4.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
