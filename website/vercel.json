{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(photos|screens|team|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(board\\.js|board-data\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/download/windows",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Rugged-Speech-Setup.exe\""
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/RuggedSpeech-Setup-Windows.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Rugged-Speech-Setup.exe\""
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/download/mac",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Rugged-Speech-Mac-AppleSilicon.dmg\""
        },
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/RuggedSpeech-Mac-AppleSilicon.dmg",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Rugged-Speech-Mac-AppleSilicon.dmg\""
        },
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/download/mac-intel",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Rugged-Speech-Mac-Intel.dmg\""
        },
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/RuggedSpeech-Mac-Intel.dmg",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Rugged-Speech-Mac-Intel.dmg\""
        },
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/SHA256SUMS.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/download/windows",
      "destination": "/downloads/RuggedSpeech-Setup-Windows.exe"
    },
    {
      "source": "/download/mac",
      "destination": "/downloads/RuggedSpeech-Mac-AppleSilicon.dmg"
    },
    {
      "source": "/download/mac-intel",
      "destination": "/downloads/RuggedSpeech-Mac-Intel.dmg"
    }
  ]
}
